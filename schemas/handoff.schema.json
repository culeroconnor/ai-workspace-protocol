{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-workspace-protocol:handoff:1.1",
  "title": "AI Workspace Protocol — Portable handoff",
  "description": "Reconstrucción v1.0 desde informe PDF. Los resultados validados requieren método y evidencia; no equivale a prueba automática de la evidencia.",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "created_at",
    "protocol_version",
    "operating_level",
    "source",
    "scope",
    "objective",
    "status",
    "completed",
    "validated",
    "decisions",
    "files_changed",
    "errors",
    "risks",
    "unresolved",
    "next_actions",
    "authority_sources",
    "checkpoints",
    "log_refs",
    "knowledge_candidates",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "operating_level": {
      "const": 7,
      "description": "Identificador propietario sin permisos ni semántica inferida."
    },
    "source": {
      "type": "object",
      "required": [
        "platform",
        "surface",
        "model",
        "session_id"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": [
        "context_mode",
        "project_id",
        "project_root",
        "git_branch",
        "topic_id"
      ],
      "properties": {
        "context_mode": {
          "enum": [
            "project",
            "general"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "topic_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "context_mode": {
                "const": "general"
              }
            }
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "null"
              },
              "project_root": {
                "type": "null"
              },
              "git_branch": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "consumed",
        "archived",
        "blocked"
      ]
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated": {
      "type": "array",
      "description": "Sólo afirmaciones comprobadas, con método y referencia a evidencia.",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "method",
          "evidence_ref"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          },
          "authority": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "change_summary"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "change_summary": {
            "type": "string",
            "minLength": 1
          },
          "hash_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "summary"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "normalized_error_signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution_status": {
            "enum": [
              "unresolved",
              "mitigated",
              "resolved",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "log_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "summary",
          "destination"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "enum": [
              "user_profile",
              "Project_Brain_Generic",
              "project_brain",
              "undetermined"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "reviewed",
              "approved",
              "rejected"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "classification",
        "secrets_included",
        "redactions"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "secrets_included": {
          "type": "boolean"
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
